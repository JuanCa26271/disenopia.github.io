# Base de datos PostgreSQL principal
DATABASE_URL=postgresql://maga:change-this@localhost:5432/maga?schema=public

# Clave de 32 bytes en base64 para cifrado AES-256-GCM (generar con: openssl rand -base64 32)
CUSTOMER_DATA_KEY=

# Contraseña temporal inicial del administrador (para seed y preview local; mínimo 10 caracteres)
ADMIN_INITIAL_PASSWORD=

# Orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:4173

# Puerto opcional para el servidor de autenticación local (tools/local-admin-auth.mjs)
LOCAL_AUTH_PORT=4000
