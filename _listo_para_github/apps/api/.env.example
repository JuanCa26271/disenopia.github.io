NODE_ENV=development
PORT=4000
PUBLIC_API_ORIGIN=http://localhost:4000
UPLOAD_DIR=./private-uploads
DATABASE_URL=postgresql://maga:change-this@localhost:5432/maga?schema=public
# Generate with: openssl rand -base64 32
CUSTOMER_DATA_KEY=
# Separate key for encrypted customer image files. Generate independently.
ASSET_DATA_KEY=
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=maga-api
JWT_AUDIENCE=maga-admin
ADMIN_ORIGIN=http://localhost:3001
STORE_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
ASSET_HOST_ALLOWLIST=assets.example.com
# Set once in the protected deployment environment, then rotate after first login.
ADMIN_INITIAL_PASSWORD=
INITIAL_DAILY_WORK_MINUTES=480
INITIAL_MINIMUM_BUFFER_HOURS=24
