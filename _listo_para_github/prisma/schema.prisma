generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum OrderStatus { PENDING IN_PRODUCTION FINISHED DELIVERED CANCELLED }
model Admin { id String @id @default(uuid()) @db.Uuid username String @unique passwordHash String @map("password_hash") lastLogin DateTime? @map("last_login") failedAttempts Int @default(0) @map("failed_attempts") lockedUntil DateTime? @map("locked_until") createdAt DateTime @default(now()) @map("created_at") @@map("admins") }
model Category { id String @id @default(uuid()) @db.Uuid name String @unique baseProductionTimeMinutes Int @map("base_production_time_minutes") isActive Boolean @default(true) @map("is_active") products Product[] @@map("categories") }
model Product { id String @id @default(uuid()) @db.Uuid categoryId String @db.Uuid @map("category_id") category Category @relation(fields:[categoryId],references:[id],onDelete:Restrict) name String description String @default("") basePrice Decimal @db.Decimal(10,2) @map("base_price") stockReady Int @default(0) @map("stock_ready") madeToOrderTimeMinutes Int @default(0) @map("made_to_order_time_minutes") referenceImages Json @default("[]") @map("reference_images_json") isCustomizable Boolean @default(false) @map("is_customizable") isActive Boolean @default(true) @map("is_active") items OrderItem[] @@index([categoryId,isActive]) @@map("products") }
model CustomizationOption { id String @id @default(uuid()) @db.Uuid optionType String @map("option_type") name String extraCost Decimal @db.Decimal(10,2) @map("extra_cost") extraProductionTimeMinutes Int @default(0) @map("extra_production_time_minutes") imagePreviewUrl String? @map("image_preview_url") isAvailable Boolean @default(true) @map("is_available") customizations OrderItemCustomization[] @@map("customization_options") }
model FontCatalog { id String @id @default(uuid()) @db.Uuid fontName String @map("font_name") fontFileUrl String @map("font_file_url") isActive Boolean @default(true) @map("is_active") customizations OrderItemCustomization[] @@map("font_catalog") }
model PredefinedTemplate { id String @id @default(uuid()) @db.Uuid name String eventType String @map("event_type") designUrl String @map("design_url") dimensionsMm Json @map("dimensions_mm") customizations OrderItemCustomization[] @@map("predefined_templates") }
model Customer { id String @id @default(uuid()) @db.Uuid firstNameEncrypted String @map("first_name_encrypted") lastNameEncrypted String @map("last_name_encrypted") phoneEncrypted String @map("phone_encrypted") createdAt DateTime @default(now()) @map("created_at") orders Order[] @@map("customers") }
model Order { id String @id @default(uuid()) @db.Uuid ticketNumber String @unique @map("ticket_number") customerId String @db.Uuid @map("customer_id") customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict) status OrderStatus @default(PENDING) @map("order_status") totalPrice Decimal @db.Decimal(10,2) @map("total_price") estimatedReadyDate DateTime @map("estimated_ready_date") requestedDeliveryDate DateTime @map("requested_delivery_date") createdAt DateTime @default(now()) @map("created_at") items OrderItem[] @@index([status,requestedDeliveryDate]) @@map("orders") }
model OrderItem { id String @id @default(uuid()) @db.Uuid orderId String @db.Uuid @map("order_id") order Order @relation(fields:[orderId],references:[id],onDelete:Cascade) productId String @db.Uuid @map("product_id") product Product @relation(fields:[productId],references:[id],onDelete:Restrict) quantity Int unitCalculatedPrice Decimal @db.Decimal(10,2) @map("unit_calculated_price") subtotal Decimal @db.Decimal(10,2) customizations OrderItemCustomization[] @@map("order_items") }
model OrderItemCustomization { id String @id @default(uuid()) @db.Uuid orderItemId String @db.Uuid @map("order_item_id") orderItem OrderItem @relation(fields:[orderItemId],references:[id],onDelete:Cascade) optionId String? @db.Uuid @map("customization_option_id") option CustomizationOption? @relation(fields:[optionId],references:[id],onDelete:SetNull) customText String? @map("custom_text") fontId String? @db.Uuid @map("font_id") font FontCatalog? @relation(fields:[fontId],references:[id],onDelete:SetNull) uploadedPhotoUrl String? @map("uploaded_photo_url") templateId String? @db.Uuid @map("template_id") template PredefinedTemplate? @relation(fields:[templateId],references:[id],onDelete:SetNull) printReadyAssetUrl String? @map("print_ready_asset_url") assetWidthMm Decimal? @db.Decimal(8,2) @map("asset_width_mm") assetHeightMm Decimal? @db.Decimal(8,2) @map("asset_height_mm") @@map("order_item_customizations") }
model ProductionSettings { id String @id @default(uuid()) @db.Uuid dailyWorkHours Decimal @db.Decimal(4,2) @map("daily_work_hours") bufferDays Int @default(0) @map("buffer_days") blockedDates Json @default("[]") @map("blocked_dates_json") updatedAt DateTime @updatedAt @map("updated_at") @@map("production_settings") }
model RefreshSession { id String @id @default(uuid()) @db.Uuid adminId String @db.Uuid @map("admin_id") tokenHash String @unique @map("token_hash") expiresAt DateTime @map("expires_at") revokedAt DateTime? @map("revoked_at") createdAt DateTime @default(now()) @map("created_at") @@index([adminId,revokedAt]) @@map("refresh_sessions") }
